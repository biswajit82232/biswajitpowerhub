{
  "name": "biswajit-power-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BISWAJIT POWER HUB — Premium EV dealership website & business management platform.",
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "build": "node scripts/generate-sitemap.mjs && vite build && node scripts/fallback-prerender.mjs",
    "qa:seo": "node scripts/qa-seo-check.mjs",
    "qa:gsc": "node scripts/gsc-deep-audit.mjs",
    "prerender": "node scripts/prerender.mjs",
    "prerender:browser": "node scripts/prerender.mjs && node scripts/fallback-prerender.mjs",
    "prerender:fallback": "node scripts/fallback-prerender.mjs",
    "brand-pngs": "node scripts/generate-brand-pngs.mjs",
    "prebuild": "node scripts/generate-brand-pngs.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:check": "node scripts/check-supabase.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "keep-alive": "node scripts/keep-alive.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "pg": "^8.13.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.21"
  }
}
