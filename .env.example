# Supabase — copy to .env and fill with your project values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Database password (Supabase → Project Settings → Database) — for npm run db:migrate only
# SUPABASE_DB_PASSWORD=your-database-password
# Or use a full connection string:
# DATABASE_URL=postgresql://postgres:...@db.your-project-ref.supabase.co:5432/postgres

# Comma-separated emails allowed to access /admin (required in production)
VITE_ADMIN_EMAILS=your-admin@example.com

VITE_GA_MEASUREMENT_ID=G-ZPSM06SEY4

# Google Ads Conversion / Remarketing ID (from ads.google.com → Tools → Conversions)
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Google Search Console HTML-tag verification token (content= value only, not the full meta tag)
# VITE_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL (canonical links, Open Graph — set in Vercel Production env)
VITE_SITE_URL=https://biswajitpowerhub.in

# Google Business Profile Place ID (enables “Write a Google review” deep link)
# VITE_GOOGLE_PLACE_ID=ChIJ...
