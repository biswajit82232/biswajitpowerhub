{
  "name": "BPH Admin",
  "short_name": "Admin",
  "description": "Dealership admin — leads, callbacks, bookings, and inventory",
  "id": "/admin?source=pwa",
  "start_url": "/admin?source=pwa",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "theme_color": "#2563EB",
  "background_color": "#F8FAFC",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/admin/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "url": "/admin?source=pwa",
      "icons": [{ "src": "/admin/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Callbacks",
      "short_name": "Callbacks",
      "url": "/admin/callbacks?source=pwa",
      "icons": [{ "src": "/admin/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/admin/messages?source=pwa",
      "icons": [{ "src": "/admin/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/admin/settings?source=pwa",
      "icons": [{ "src": "/admin/icon-96.png", "sizes": "96x96" }]
    }
  ]
}
